# Public host name of the server. Its DNS record must point at this machine,
# and ports 80, 443 and 8883 must be reachable from the internet.
DOMAIN=buttons.example.com

# Address Let's Encrypt uses for expiry warnings.
ACME_EMAIL=you@example.com

# Address of the first administrator. After the first start, create the account with:
#   docker compose exec app python -m app.create_admin
ADMIN_EMAIL=you@example.com

# Long random strings. Generate each with: openssl rand -base64 48
# SECRET_KEY protects the device CA key and two-step secrets. If you lose it,
# every button must be claimed again. Back it up.
SECRET_KEY=
POSTGRES_PASSWORD=

# Time zone for date filters and for buttons that have no location time zone.
DEFAULT_TZ=America/New_York
